<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="stock_sales_reservation_view_list" model="ir.ui.view">
        <field name="name">stock.sales.reservation.list</field>
        <field name="model">stock.sales.reservation</field>
        <field name="arch" type="xml">
            <list
                decoration-muted="state in ('expired', 'cancelled')"
                decoration-success="state == 'reserved'"
                decoration-info="state == 'done'"
            >
                <field name="name" />
                <field name="user_id" widget="many2one_avatar_user" />
                <field name="partner_id" optional="show" />
                <field name="product_id" />
                <field name="product_qty" />
                <field name="uom_id" groups="uom.group_uom" />
                <field name="expiry_date" optional="show" />
                <field name="state" widget="badge" />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <record id="stock_sales_reservation_view_form" model="ir.ui.view">
        <field name="name">stock.sales.reservation.form</field>
        <field name="model">stock.sales.reservation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_reserve"
                        string="Reserve"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'draft'"
                    />
                    <button
                        name="action_cancel"
                        string="Release"
                        type="object"
                        invisible="state not in ('draft', 'reserved')"
                        confirm="The reserved stock will be released. Continue?"
                    />
                    <button
                        name="action_set_draft"
                        string="Set to Draft"
                        type="object"
                        invisible="state not in ('expired', 'cancelled')"
                    />
                    <field name="state" widget="statusbar" statusbar_visible="draft,reserved" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="product_id" readonly="state != 'draft'" />
                            <label for="product_qty" />
                            <div class="o_row">
                                <field name="product_qty" readonly="state != 'draft'" />
                                <field name="uom_id" groups="uom.group_uom" />
                            </div>
                            <field name="available_qty" invisible="state != 'draft'" />
                            <field name="partner_id" readonly="state in ('expired', 'cancelled', 'done')" />
                        </group>
                        <group>
                            <field name="user_id" readonly="state != 'draft'" />
                            <field name="warehouse_id" readonly="state != 'draft'" />
                            <field
                                name="expiry_duration"
                                readonly="state in ('expired', 'cancelled', 'done')"
                            />
                            <field name="date_reserved" invisible="not date_reserved" />
                            <field name="expiry_date" invisible="not expiry_date" />
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'" />
                            <field
                                name="picking_id"
                                groups="stock.group_stock_user"
                                invisible="not picking_id"
                            />
                        </group>
                    </group>
                    <field name="note" placeholder="Reason for the reservation..." />
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="stock_sales_reservation_view_search" model="ir.ui.view">
        <field name="name">stock.sales.reservation.search</field>
        <field name="model">stock.sales.reservation</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="product_id" />
                <field name="partner_id" />
                <field name="user_id" />
                <filter
                    name="my_reservations"
                    string="My Reservations"
                    domain="[('user_id', '=', uid)]"
                />
                <separator />
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]" />
                <filter name="reserved" string="Reserved" domain="[('state', '=', 'reserved')]" />
                <filter name="expired" string="Expired" domain="[('state', '=', 'expired')]" />
                <group>
                    <filter name="group_user" string="Salesperson" context="{'group_by': 'user_id'}" />
                    <filter name="group_product" string="Product" context="{'group_by': 'product_id'}" />
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="stock_sales_reservation_action" model="ir.actions.act_window">
        <field name="name">Stock Reservations</field>
        <field name="res_model">stock.sales.reservation</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="stock_sales_reservation_view_search" />
        <field name="context">{'search_default_my_reservations': 1}</field>
    </record>

    <menuitem
        id="stock_sales_reservation_menu_root"
        name="Stock Reservations"
        action="stock_sales_reservation_action"
        sequence="45"
        groups="group_sales_reservation_user,stock.group_stock_user"
        web_icon="stock,static/description/icon.png"
    />
</odoo>
